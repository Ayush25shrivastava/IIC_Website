# Runtime
NODE_ENV=development
PORT=5001
TRUST_PROXY_HOPS=0
REQUEST_BODY_LIMIT=1mb

# Frontend origins. Separate multiple origins with commas.
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/renaissance_2026
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=0
# 4 = IPv4 only. This is the most reliable choice for Atlas on Windows/local networks.
# Use 0 only if you intentionally want the driver to try both IPv4 and IPv6.
MONGO_FAMILY=4
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000

# Campus Ambassador authentication. Use different random secret values.
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-random-secret-at-least-32-characters

JWT_ISSUER=renaissance-server1
JWT_AUDIENCE=renaissance-campus-ambassador
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Keep false for local HTTP development and true in production HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# AUTH_COOKIE_DOMAIN=.example.com
